    "IOC-HASH": {
      "assets": [
        "hostname"
      ],
      "level": 3,
      "effect": "A file with a hash on a threat feed was seen",
      "cia": [
        "I"
      ]
    },
    "IOA-018": {
      "assets": [
        "hostname"
      ],
      "level": 1,
      "effect": "Another tool raised an alert about it",
