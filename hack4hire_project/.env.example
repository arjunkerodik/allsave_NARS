# Copy this file to .env and fill in what you use. .env is ignored by git, so never rename it or
# paste a real key into this example. Real environment variables win over .env.

# NARS: with a key it uses an AI model, and the stored data it reads is sent to that service.
# Without one it runs in local mode, and nothing leaves this machine.
GROQ_API_KEY=
# NARS_MODEL=openai/gpt-oss-120b
# NARS_MODE=local

# Alert emails, sent when an incident reaches ALLSAFE_ALERT_EMAIL_MIN_RISK.
# For Gmail: smtp.gmail.com, port 587, and an app password, not your normal password.
ALLSAFE_SMTP_HOST=
ALLSAFE_SMTP_PORT=587
ALLSAFE_SMTP_USER=
ALLSAFE_SMTP_PASSWORD=
ALLSAFE_ALERT_EMAIL_FROM=
# One address, or several separated by commas
ALLSAFE_ALERT_EMAIL_TO=
ALLSAFE_ALERT_EMAIL_MIN_RISK=HIGH
ALLSAFE_ALERT_EMAIL_MAX_PER_HOUR=20
# ALLSAFE_SMTP_SECURITY=starttls
# ALLSAFE_PUBLIC_URL=http://127.0.0.1:5001

# Accounts: set this so that logins survive a restart
# ALLSAFE_SECRET_KEY=

# Real mode is off by default, and responses run in simulation. With 1, an analyst who approves
# "Block test IP" adds a real Windows Firewall rule on this machine, and can undo it.
# ALLSAFE must be started from an Administrator terminal. Automation never makes a real change.
# ALLSAFE_REAL_RESPONSE=1
